generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(255)
  surname  String @db.VarChar(255)
    email    String @unique
  password String @db.VarChar(255)
}
